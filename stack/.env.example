# Guardrail stack v2 environment.
# Copy to stack/.env and fill in. Generate the two LiteLLM keys with:
#   printf 'LITELLM_MASTER_KEY=sk-%s\nLITELLM_SALT_KEY=sk-%s\n' \
#     "$(openssl rand -hex 32)" "$(openssl rand -hex 32)"

# --- required ---
POSTGRES_PASSWORD=change-me
LITELLM_MASTER_KEY=sk-change-me
# Generate ONCE. Never change after first start: it encrypts provider keys
# stored in Postgres and regenerating makes them unreadable.
LITELLM_SALT_KEY=sk-change-me

# --- Claude Haiku via AWS Bedrock (judge-claude) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# --- llama.cpp endpoints (configure later; used by bootstrap_models.py) ---
# Reachable from the litellm container. host.docker.internal = llama.cpp on the host.
VICTIM_API_BASE=http://host.docker.internal:8080/v1
BF16_API_BASE=http://host.docker.internal:8081/v1
VICTIM_MODEL_ID=meta-llama-3.1-8b-instruct
BF16_MODEL_ID=meta-llama-3.1-8b-instruct-bf16
